{
  "name": "HR Position (EDW dept leaders)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hr-position",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "aa000001-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "hr-position",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_IN_N8N",
          "name": "X-API-Key (hr-dept 워크플로와 동일 자격증명 선택)"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DT, DEPTCO, EMPID, NAME, FRNM\nFROM dbo.VW_HR_EMP_CENTER_MAPPING\nWHERE DT = (\n  SELECT MAX(DT) FROM dbo.VW_HR_EMP_CENTER_MAPPING\n  WHERE DT <= CONVERT(varchar(8), GETDATE(), 112)\n)\n  AND FRNM IS NOT NULL\n  AND LTRIM(RTRIM(FRNM)) <> N''\n  AND LTRIM(RTRIM(FRNM)) <> N'프로'",
        "options": {}
      },
      "id": "aa000001-0000-4000-8000-000000000002",
      "name": "EDW Leaders",
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.1,
      "position": [220, 0],
      "credentials": {
        "microsoftSql": {
          "id": "REPLACE_IN_N8N",
          "name": "EDW MSSQL (n8n에서 실제 커넥션 선택)"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// MSSQL 행 → 백엔드 계약 {kind, dt, count, rows}. 트림 후 empId·position 결측 행 제외.\nconst items = $input.all().map((i) => i.json);\nconst rows = items\n  .map((r) => ({\n    empId: String(r.EMPID ?? '').trim(),\n    deptCode: String(r.DEPTCO ?? '').trim(),\n    name: String(r.NAME ?? '').trim(),\n    position: String(r.FRNM ?? '').trim(),\n  }))\n  .filter((r) => r.empId && r.position);\nconst dt = items.length ? String(items[0].DT ?? '') : '';\nreturn [{ json: { kind: 'positions', dt, count: rows.length, rows } }];"
      },
      "id": "aa000001-0000-4000-8000-000000000003",
      "name": "Shape Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "aa000001-0000-4000-8000-000000000004",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "EDW Leaders", "type": "main", "index": 0 }]]
    },
    "EDW Leaders": {
      "main": [[{ "node": "Shape Response", "type": "main", "index": 0 }]]
    },
    "Shape Response": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
